{% extends 'base.html.twig' %}

{% block title %}The Klassiker — Smash Burgers & Kebabs à Évry-Courcouronnes{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .product-modal {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .product-modal.is-open { display: flex; }
    .modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(4px);
    }
    .modal-content {
      position: relative;
      background: #fff;
      border-radius: 26px;
      max-width: 700px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      animation: modalSlideIn 0.3s ease;
    }
    @keyframes modalSlideIn {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .modal-close {
      position: absolute;
      top: 12px; right: 12px;
      width: 36px; height: 36px;
      border: none;
      background: rgba(0,0,0,0.5);
      color: #fff;
      border-radius: 50%;
      font-size: 1.4rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }
    .modal-close:hover { background: #9a1515; }
    .modal-product-detail {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .modal-product-image {
      background: linear-gradient(135deg, #ffcf70 0%, #9a1515 55%, #25060a 100%);
    }
    .modal-product-image img {
      width: 100%; height: 100%;
      object-fit: cover;
      min-height: 300px;
    }
    .modal-product-info { padding: 24px; }
    .modal-product-category {
      display: inline-block;
      background: rgba(11,27,50,0.08);
      color: #0b1b32;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 10px;
    }
    .modal-product-title {
      font-size: 1.5rem;
      color: #0b1b32;
      margin: 0 0 12px;
      text-transform: uppercase;
    }
    .modal-product-desc {
      color: #555;
      line-height: 1.6;
      margin-bottom: 16px;
      font-size: 0.9rem;
    }
    .modal-product-price {
      font-size: 1.8rem;
      font-weight: 800;
      color: #9a1515;
      margin-bottom: 20px;
    }
    .modal-product-form .form-group { margin-bottom: 14px; }
    .modal-product-form .form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #0b1b32;
      margin-bottom: 6px;
    }
    .modal-qty-controls {
      display: inline-flex;
      border: 2px solid #0b1b32;
      border-radius: 10px;
      overflow: hidden;
    }
    .modal-qty-btn {
      width: 40px; height: 40px;
      border: none;
      background: #0b1b32;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-qty-btn:hover { background: #ffbc00; color: #0b1b32; }
    .modal-qty-controls input {
      width: 50px; height: 40px;
      border: none;
      text-align: center;
      font-weight: 700;
      color: #0b1b32;
      background: transparent;
    }
    .modal-product-form textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.9rem;
      resize: vertical;
    }
    .modal-product-form textarea:focus { outline: none; border-color: #0b1b32; }
    .modal-btn-add {
      width: 100%;
      padding: 14px;
      background: #ffbc00;
      color: #0b1b32;
      border: none;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .modal-btn-add:hover { background: #ffc300; }
    @media (max-width: 600px) {
      .modal-product-detail { grid-template-columns: 1fr; }
      .modal-product-image img { min-height: 200px; }
    }
  </style>
{% endblock %}

