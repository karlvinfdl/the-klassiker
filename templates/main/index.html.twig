        Smash burgers, chicken, kebabs, boissons, sides & desserts.
      </p>
    </div>

    <div class="cards-grid" data-animate="fade-up">
      {# Afficher les plats par catégorie #}
      {% if categories %}
        {% set globalIndex = 0 %}
        {% for category in categories %}
          {% if category.dishes|length > 0 %}
            {% for dish in category.dishes %}
              {% set globalIndex = globalIndex + 1 %}
              <div class="food-card-link product-modal-trigger"
                   data-dish-id="{{ dish.id }}"
                   data-dish-name="{{ dish.name }}"
                   data-dish-description="{{ dish.description }}"
                   data-dish-price="{{ dish.price|number_format(2, ',', ' ') }}"
                   data-dish-category="{{ category.name }}"
                   data-dish-image="{{ dish.image }}">
                <article class="food-card{% if globalIndex > 4 %} food-card-to-hide{% endif %}">
                  {% if dish.image %}
                    {% set localDishImages = ['1-.webp', '2-.webp', '3-.webp', '4-.webp', '5-.webp', '6-.webp', '7-.webp', '8-.webp', '9-.webp', '10-.webp', '11-.webp', '12-.webp'] %}
                    {% if dish.image in localDishImages %}
                      <img src="{{ asset('build/images/' ~ dish.image) }}" alt="{{ dish.name }}">
                    {% else %}
                      <img src="{{ asset('uploads/' ~ dish.image) }}" alt="{{ dish.name }}">
                    {% endif %}
                  {% else %}
                    <img src="{{ asset('build/images/' ~ random(['1-.webp', '2-.webp', '3-.webp', '4-.webp'])) }}" alt="{{ dish.name }}">
                  {% endif %}
                  <div class="food-body">
                    <h3>{{ dish.name }}</h3>
                    <p>{{ dish.description }}</p>
                    <div class="food-footer">
                      <span class="food-tag">{{ category.name }}</span>
                      <span class="food-price">{{ dish.price|number_format(2, ',', ' ') }} €</span>
                    </div>
                  </div>
                </article>
              </div>
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% else %}
