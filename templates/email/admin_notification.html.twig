<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Nouveau message de contact</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background: linear-gradient(135deg, #0B1B32, #9A1515); padding: 30px; border-radius: 10px 10px 0 0;">
        <h1 style="color: #FFBC00; margin: 0; text-align: center;">The Klassiker</h1>
        <p style="color: #fff; text-align: center; margin-top: 10px;">Smash Burgers & Kebabs</p>
    </div>
    
    <div style="background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px;">
        <h2 style="color: #0B1B32;">Nouveau message de contact</h2>
        
        <div style="background: #fff; padding: 20px; border-radius: 8px; margin: 20px 0;">
            <p style="margin: 0;"><strong>Nom :</strong> {{ message.firstName }} {{ message.lastName }}</p>
            <p style="margin: 10px 0 0;"><strong>Email :</strong> <a href="mailto:{{ message.email }}">{{ message.email }}</a></p>
            {% if message.phone %}
            <p style="margin: 10px 0 0;"><strong>Téléphone :</strong> <a href="tel:{{ message.phone }}">{{ message.phone }}</a></p>
            {% endif %}
            <p style="margin: 10px 0 0;"><strong>Sujet :</strong> {{ message.subject }}</p>
            <p style="margin: 10px 0 0;"><strong>Date :</strong> {{ message.createdAt|date('d/m/Y à H:i') }}</p>
            <p style="margin: 20px 0 0;"><strong>Message :</strong></p>
            <p style="margin: 5px 0 0; color: #666; white-space: pre-wrap;">{{ message.message }}</p>
        </div>
        
        <p><a href="{{ url('admin_message_show', {id: message.id}) }}" style="display: inline-block; background: #FFBC00; color: #0B1B32; padding: 12px 24px; text-decoration: none; border-radius: 5px; font-weight: bold;">Voir le message dans l'admin</a></p>
    </div>
    
    <div style="text-align: center; margin-top: 20px; color: #999; font-size: 12px;">
        <p>© {{ 'now'|date('Y') }} The Klassiker - Administration</p>
    </div>
</body>
</html>

