<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nouvelle commande</title>
  <style>
    body { font-family: 'Montserrat', Arial, sans-serif; background: #0b1b32; color: #f8f8f8; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: linear-gradient(180deg, #182c4f 0%, #0b1b32 100%); border-radius: 20px; padding: 30px; }
    .header { text-align: center; margin-bottom: 30px; }
    .logo { font-size: 28px; font-weight: 800; color: #ffbc00; letter-spacing: 0.1em; text-transform: uppercase; }
    .title { font-size: 22px; color: #9a1515; margin: 20px 0 10px; }
    .order-info { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; margin: 20px 0; }
    .order-info p { margin: 8px 0; }
    .items { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; margin-top: 20px; }
    .item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .item-name { font-weight: 600; }
    .item-qty { color: #ffbc00; }
    .total { font-size: 20px; font-weight: 700; text-align: right; margin-top: 20px; color: #ffbc00; }
    .footer { text-align: center; margin-top: 30px; font-size: 14px; opacity: 0.7; }
    .type-badge { display: inline-block; background: #9a1515; padding: 5px 15px; border-radius: 20px; font-size: 12px; text-transform: uppercase; }
    .urgent { color: #ff4444; font-weight: bold; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">The Klassiker</div>
      <h1 class="title">🛒 Nouvelle commande reçue !</h1>
    </div>

    <div class="order-info">
      <p><strong>N° de commande :</strong> #{{ order.id }}</p>
      <p><strong>Type :</strong> <span class="type-badge">{{ order.type == 'delivery' ? '🚗 Livraison' : '📦 Click & Collect' }}</span></p>
      <p><strong>Date :</strong> {{ order.createdAt|date('d/m/Y à H:i') }}</p>
      <p><strong>Client :</strong> {{ order.customerName }}</p>
      <p><strong>Téléphone :</strong> <a href="tel:{{ order.customerPhone }}" style="color: #ffbc00;">{{ order.customerPhone }}</a></p>
      {% if order.customerEmail %}
        <p><strong>Email :</strong> {{ order.customerEmail }}</p>
      {% endif %}
      {% if order.type == 'delivery' and order.deliveryAddress %}
        <p><strong>Adresse de livraison :</strong></p>
        <p>{{ order.deliveryAddress|nl2br }}</p>
      {% endif %}
    </div>

    <div class="items">
      <h3>Articles</h3>
      {% for item in order.items %}
        <div class="item">
          <span class="item-name">{{ item.dishName }}{% if item.specialInstructions %} <em style="opacity: 0.7;">({{ item.specialInstructions }})</em>{% endif %}</span>
          <span class="item-qty">x{{ item.quantity }}</span>
          <span>{{ (item.quantity * item.unitPrice)|number_format(2, ',', ' ') }} €</span>
        </div>
      {% endfor %}
      
      <div class="total">
        Total : {{ order.totalAmount|number_format(2, ',', ' ') }} €
      </div>
    </div>

    {% if order.comments %}
    <div class="order-info">
      <p class="urgent">📝 Notes spéciales :</p>
      <p>{{ order.comments|nl2br }}</p>
    </div>
    {% endif %}

    <div class="footer">
      <p>📍 12 Cours Monseigneur Roméro, 91000 Évry-Courcouronnes</p>
      <p>📞 01 64 99 37 77</p>
    </div>
  </div>
</body>
</html>

