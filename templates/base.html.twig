<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>{% block title %}The Klassiker — Burgers & Kebabs à Évry{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{% block meta_description %}The Klassiker - Smash burgers & kebabs à Évry-Courcouronnes. Viande smashée à la minute, sauces maison, portions généreuses.{% endblock %}" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0b1b32" />

  <!-- Canonical -->
  <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}" />

  <!-- Open Graph -->
  <meta property="og:type" content="restaurant" />
  <meta property="og:site_name" content="The Klassiker" />
  <meta property="og:title" content="{{ block('title') }}" />
  <meta property="og:description" content="{{ block('meta_description') }}" />
  <meta property="og:image" content="{{ app.request.schemeAndHttpHost ~ asset('build/images/hero1.webp') }}" />
  <meta property="og:url" content="{{ app.request.uri }}" />
  <meta property="og:locale" content="fr_FR" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ block('title') }}" />
  <meta name="twitter:description" content="{{ block('meta_description') }}" />
  <meta name="twitter:image" content="{{ app.request.schemeAndHttpHost ~ asset('build/images/hero1.webp') }}" />

  <!-- Polices + Icônes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

  {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
  {% endblock %}

  <link rel="icon" type="image/webp" href="{{ asset('build/images/logo.webp') }}" />

  <!-- Données structurées JSON-LD (LocalBusiness / Restaurant) -->
  {% block structured_data %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "The Klassiker",
    "description": "Smash burgers & kebabs à Évry-Courcouronnes. Viande smashée à la minute, sauces maison, portions généreuses.",
    "url": "{{ app.request.schemeAndHttpHost }}",
    "telephone": "+33164993777",
    "email": "the.klassiker@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "12 Cours Monseigneur Roméro",
      "addressLocality": "Évry-Courcouronnes",
      "postalCode": "91000",
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 48.6253,
      "longitude": 2.4450
    },
    "servesCuisine": ["Burgers", "Kebab", "Fast-food"],
    "priceRange": "€€",
    "image": "{{ app.request.schemeAndHttpHost ~ asset('build/images/hero1.webp') }}",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday"],
        "opens": "11:00",
        "closes": "23:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Friday","Saturday","Sunday"],
        "opens": "11:00",
        "closes": "00:00"
      }
    ],
    "sameAs": [
      "https://www.facebook.com/p/The-Klassiker-100070645848253/",
      "https://www.instagram.com/theklassiker/",
      "https://www.tiktok.com/@the.klassiker"
    ],
    "hasMenu": "{{ app.request.schemeAndHttpHost ~ path('app_order') }}"
  }
  </script>
  {% endblock %}

  {% block extra_head %}{% endblock %}
</head>

<body>
  <!-- ================= HEADER ================= -->
  <header class="site-header">
    <div class="header-inner">
      <a href="{{ path('app_home') }}" class="brand">
        <img src="{{ asset('build/images/logo.webp') }}" alt="Logo The Klassiker" width="70" height="70">
        <span class="brand-text">
          <span class="brand-name">The Klassiker</span>
          <span class="brand-tagline">Smash burgers & kebabs</span>
        </span>
      </a>

      <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="mainNav" aria-label="Navigation principale">
        <a href="{{ path('app_home') }}#accueil" class="nav-link{% if app.request.uri == path('app_home') %} active{% endif %}">Accueil</a>
        <a href="{{ path('app_home') }}#galerie" class="nav-link">Galerie</a>
        <a href="{{ path('app_recrutement') }}" class="nav-link{% if app.request.uri == path('app_recrutement') %} active{% endif %}">Recrutement</a>
        <a href="{{ path('app_contact') }}" class="nav-link{% if app.request.uri == path('app_contact') %} active{% endif %}">Contact</a>
        <a href="{{ path('app_order') }}" class="nav-link{% if app.request.attributes.get('_route') starts with 'app_order' %} active{% endif %}">Notre carte</a>
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
          <a href="{{ path('app_user_dashboard') }}" class="nav-icon" aria-label="Mon compte" title="Mon compte">
            <i class="fas fa-user-circle"></i>
          </a>
          <a href="{{ path('app_logout') }}" class="nav-icon" aria-label="Déconnexion" title="Déconnexion">
            <i class="fas fa-sign-out-alt"></i>
          </a>
        {% else %}
          <a href="{{ path('app_login') }}" class="nav-icon" aria-label="Connexion" title="Connexion">
            <i class="fas fa-user"></i>
          </a>
        {% endif %}

        <a href="{{ path('app_order_cart') }}" class="nav-icon" aria-label="Panier" title="Mon panier">
          <i class="fas fa-shopping-basket"></i>
        </a>

        <div class="nav-social-mobile">
          <div class="social-links">
            <a href="https://www.facebook.com/p/The-Klassiker-100070645848253/?locale=fr_FR" target="_blank" rel="noopener noreferrer" aria-label="Suivez-nous sur Facebook">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="https://www.instagram.com/theklassiker/" target="_blank" rel="noopener noreferrer" aria-label="Suivez-nous sur Instagram">
              <i class="fab fa-instagram"></i>
            </a>
            <a href="https://www.tiktok.com/@the.klassiker" target="_blank" rel="noopener noreferrer" aria-label="Suivez-nous sur TikTok">
              <i class="fab fa-tiktok"></i>
            </a>
          </div>
          <p class="nav-copy">© {{ 'now'|date('Y') }} The Klassiker</p>
        </div>
      </nav>
    </div>
  </header>

  <main id="main-content">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label }}" role="alert">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="site-footer">
    <div class="footer-inner">
      <p>© {{ 'now'|date('Y') }} The Klassiker — Tous droits réservés</p>
      <div class="social-links">
        <a href="https://www.facebook.com/p/The-Klassiker-100070645848253/?locale=fr_FR" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <i class="fab fa-facebook-f"></i>
        </a>
        <a href="https://www.instagram.com/theklassiker/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <i class="fab fa-instagram"></i>
        </a>
        <a href="https://www.tiktok.com/@the.klassiker" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <i class="fab fa-tiktok"></i>
        </a>
      </div>
    </div>
  </footer>

  {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
  {% endblock %}
</body>
</html>
