{% extends 'admin/base.html.twig' %}

{% block title %}Modifier la photo - The Klassiker Admin{% endblock %}
{% block page_title %}Modifier la photo{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Modifier la photo</h2>
  
  <div class="mb-3">
    <label class="form-label">Image actuelle :</label>
    <div class="mb-2">
      {# Check if it's a local image (from build/images/) or uploaded image (from uploads/) #}
      {% set localGalleryImages = ['galerie-11.webp', 'galerie-12.webp', 'galerie-13.webp', 'galerie-14.webp', 'galerie-15.webp', 'galerie-16.webp', 'galerie-17.webp', 'galerie-18.webp', 'galerie-19.webp', 'galerie-20.webp', 'galerie-21.webp', 'galerie-22.webp', 'galerie-23.webp', 'galerie-24.webp', 'galerie-25.webp', 'galerie-26.webp', 'galerie-27.webp', 'galerie-28.webp', 'galerie-29.webp', 'hero1.webp', 'livraison.webp'] %}
      {% if photo.filename in localGalleryImages %}
        <img src="{{ asset('build/images/' ~ photo.filename) }}" alt="{{ photo.altText|default('') }}" style="max-width: 300px; border-radius: 0;">
        <span class="badge bg-info ms-2">Image locale</span>
      {% else %}
        <img src="{{ asset('uploads/' ~ photo.filename) }}" alt="{{ photo.altText|default('') }}" style="max-width: 300px; border-radius: 0;">
        <span class="badge bg-secondary ms-2">Image uploadée</span>
      {% endif %}
    </div>
  </div>
  
  {{ form_start(form) }}
    {{ form_widget(form) }}
  {{ form_end(form) }}
  
  <div class="mt-3">
    <a href="{{ path('admin_photo_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
  </div>
</div>
{% endblock %}

