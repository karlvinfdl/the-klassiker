{% extends 'admin/base.html.twig' %}

{% block title %}Nouvelle photo - The Klassiker Admin{% endblock %}
{% block page_title %}Nouvelle photo{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Ajouter une nouvelle photo</h2>
  
  {{ form_start(form) }}
    {{ form_widget(form) }}
  {{ form_end(form) }}
  
  <div class="mt-3">
    <a href="{{ path('admin_photo_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
  </div>
</div>
{% endblock %}

