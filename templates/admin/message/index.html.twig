{% extends 'admin/base.html.twig' %}

{% block title %}Messages - The Klassiker Admin{% endblock %}
{% block page_title %}Messages de contact{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Liste des messages</h2>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nom</th>
        <th>Email</th>
        <th>Sujet</th>
        <th>Date</th>
        <th>Lu</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for message in messages %}
      <tr style="{{ not message.isRead ? 'background: rgba(255,188,0,0.1);' : '' }}">
        <td>{{ message.id }}</td>
        <td><strong>{{ message.firstName }} {{ message.lastName }}</strong></td>
        <td><a href="mailto:{{ message.email }}">{{ message.email }}</a></td>
        <td>{{ message.subject }}</td>
        <td>{{ message.createdAt|date('d/m/Y H:i') }}</td>
        <td>
          {% if message.isRead %}
            <span class="badge-active">Lu</span>
          {% else %}
            <span class="badge-inactive">Non lu</span>
          {% endif %}
        </td>
        <td>
          <a href="{{ path('admin_message_show', {id: message.id}) }}" class="btn btn-sm btn-outline-primary">
            <i class="fas fa-eye"></i>
          </a>
          {% if not message.isRead %}
          <form method="post" action="{{ path('admin_message_mark_read', {id: message.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('mark_read' ~ message.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-success" title="Marquer comme lu">
              <i class="fas fa-check"></i>
            </button>
          </form>
          {% else %}
          <form method="post" action="{{ path('admin_message_mark_unread', {id: message.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('mark_unread' ~ message.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-warning" title="Marquer comme non lu">
              <i class="fas fa-envelope"></i>
            </button>
          </form>
          {% endif %}
          <form method="post" action="{{ path('admin_message_delete', {id: message.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce message ?')">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="7" class="text-center">Aucun message trouvé.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

