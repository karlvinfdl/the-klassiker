{% extends 'admin/base.html.twig' %}

{% block title %}Catégories - The Klassiker Admin{% endblock %}
{% block page_title %}Catégories{% endblock %}

{% block body %}
<div class="table-card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Liste des catégories</h2>
    <a href="{{ path('admin_category_new') }}" class="btn btn-primary">
      <i class="fas fa-plus"></i> Nouvelle catégorie
    </a>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nom</th>
        <th>Slug</th>
        <th>Ordre</th>
        <th>Plats</th>
        <th>Statut</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for category in categories %}
      <tr>
        <td>{{ category.id }}</td>
        <td><strong>{{ category.name }}</strong></td>
        <td><code>{{ category.slug }}</code></td>
        <td>{{ category.displayOrder }}</td>
        <td>{{ category.dishes|length }}</td>
        <td>
          {% if category.isActive %}
            <span class="badge-active">Actif</span>
          {% else %}
            <span class="badge-inactive">Inactif</span>
          {% endif %}
        </td>
        <td>
          <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-primary">
            <i class="fas fa-edit"></i>
          </a>
          <form method="post" action="{{ path('admin_category_toggle', {id: category.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ category.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-{{ category.isActive ? 'warning' : 'success' }}">
              <i class="fas fa-{{ category.isActive ? 'eye-slash' : 'eye' }}"></i>
            </button>
          </form>
          <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?')">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="7" class="text-center">Aucune catégorie trouvée.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

