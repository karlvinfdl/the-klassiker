{% extends 'admin/base.html.twig' %}

{% block title %}Modifier la catégorie - The Klassiker Admin{% endblock %}
{% block page_title %}Modifier la catégorie{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Modifier la catégorie</h2>
  <p class="text-muted">Catégorie : <strong>{{ category.name }}</strong></p>
  
  {{ form_start(form) }}
    {{ form_widget(form) }}
  {{ form_end(form) }}
  
  <div class="mt-3">
    <a href="{{ path('admin_category_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
  </div>
</div>
{% endblock %}

