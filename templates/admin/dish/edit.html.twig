{% extends 'admin/base.html.twig' %}

{% block title %}Modifier le plat - The Klassiker Admin{% endblock %}
{% block page_title %}Modifier le plat{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Modifier le plat</h2>
  <p class="text-muted">Plat : <strong>{{ dish.name }}</strong></p>
  
{% if dish.image %}
  <div class="mb-3">
    <label class="form-label">Image actuelle :</label>
    <div class="mb-2">
      {# Check if it's a local image (from build/images/) or uploaded image (from uploads/) #}
      {% set localDishImages = ['1-.webp', '2-.webp', '3-.webp', '4-.webp', '5-.webp', '6-.webp', '7-.webp', '8-.webp', '9-.webp', '10-.webp', '11-.webp', '12-.webp'] %}
      {% if dish.image in localDishImages %}
        <img src="{{ asset('build/images/' ~ dish.image) }}" alt="{{ dish.name }}" style="max-width: 200px; border-radius: 0;">
        <span class="badge bg-info ms-2">Image locale</span>
      {% else %}
        <img src="{{ asset('uploads/' ~ dish.image) }}" alt="{{ dish.name }}" style="max-width: 200px; border-radius: 0;">
        <span class="badge bg-secondary ms-2">Image uploadée</span>
      {% endif %}
    </div>
  </div>
  {% endif %}
  
  {{ form_start(form) }}
    {{ form_widget(form) }}
  {{ form_end(form) }}
  
  <div class="mt-3">
    <a href="{{ path('admin_dish_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
  </div>
</div>
{% endblock %}

