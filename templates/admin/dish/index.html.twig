{% extends 'admin/base.html.twig' %}

{% block title %}Plats - The Klassiker Admin{% endblock %}
{% block page_title %}Plats{% endblock %}

{% block body %}
<div class="table-card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Liste des plats</h2>
    <a href="{{ path('admin_dish_new') }}" class="btn btn-primary">
      <i class="fas fa-plus"></i> Nouveau plat
    </a>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Image</th>
        <th>Nom</th>
        <th>Catégorie</th>
        <th>Prix</th>
        <th>Vedette</th>
        <th>Statut</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for dish in dishes %}
      <tr>
        <td>{{ dish.id }}</td>
        <td>
          {% if dish.image %}
            {# Check if it's a local image (from build/images/) or uploaded image (from uploads/) #}
            {% set localDishImages = ['1-.webp', '2-.webp', '3-.webp', '4-.webp', '5-.webp', '6-.webp', '7-.webp', '8-.webp', '9-.webp', '10-.webp', '11-.webp', '12-.webp'] %}
            {% if dish.image in localDishImages %}
              <img src="{{ asset('build/images/' ~ dish.image) }}" alt="{{ dish.name }}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 0;">
            {% else %}
              <img src="{{ asset('uploads/' ~ dish.image) }}" alt="{{ dish.name }}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 0;">
            {% endif %}
          {% else %}
            <div style="width: 60px; height: 60px; background: #eee; border-radius: 0; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-utensils" style="color: #999;"></i>
            </div>
          {% endif %}
        </td>
        <td><strong>{{ dish.name }}</strong></td>
        <td>{{ dish.category.name }}</td>
        <td>{{ dish.price|number_format(2, ',', ' ') }} €</td>
        <td>
          {% if dish.isFeatured %}
            <span class="badge-active"><i class="fas fa-star"></i></span>
          {% endif %}
        </td>
        <td>
          {% if dish.isActive %}
            <span class="badge-active">Actif</span>
          {% else %}
            <span class="badge-inactive">Inactif</span>
          {% endif %}
        </td>
        <td>
          <a href="{{ path('admin_dish_edit', {id: dish.id}) }}" class="btn btn-sm btn-outline-primary">
            <i class="fas fa-edit"></i>
          </a>
          <form method="post" action="{{ path('admin_dish_toggle', {id: dish.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ dish.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-{{ dish.isActive ? 'warning' : 'success' }}">
              <i class="fas fa-{{ dish.isActive ? 'eye-slash' : 'eye' }}"></i>
            </button>
          </form>
          <form method="post" action="{{ path('admin_dish_feature', {id: dish.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('feature' ~ dish.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-{{ dish.isFeatured ? 'warning' : 'secondary' }}">
              <i class="fas fa-star"></i>
            </button>
          </form>
          <form method="post" action="{{ path('admin_dish_delete', {id: dish.id}) }}" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dish.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce plat ?')">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="8" class="text-center">Aucun plat trouvé.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

