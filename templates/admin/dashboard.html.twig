{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard - The Klassiker Admin{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block body %}
<div class="row">
  <!-- Statistiques -->
  <div class="col-md-3">
    <div class="table-card text-center">
      <i class="fas fa-tags fa-2x mb-3" style="color: #FFBC00;"></i>
      <h3>{{ stats.categories }}</h3>
      <p class="text-muted mb-0">Catégories</p>
      <a href="{{ path('admin_category_index') }}" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="table-card text-center">
      <i class="fas fa-utensils fa-2x mb-3" style="color: #FFBC00;"></i>
      <h3>{{ stats.dishes }}</h3>
      <p class="text-muted mb-0">Plats</p>
      <a href="{{ path('admin_dish_index') }}" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="table-card text-center">
      <i class="fas fa-images fa-2x mb-3" style="color: #FFBC00;"></i>
      <h3>{{ stats.photos }}</h3>
      <p class="text-muted mb-0">Photos galerie</p>
      <a href="{{ path('admin_photo_index') }}" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="table-card text-center">
      <i class="fas fa-envelope fa-2x mb-3" style="color: #FFBC00;"></i>
      <h3>{{ stats.messages }}</h3>
      <p class="text-muted mb-0">Messages{% if stats.unreadMessages > 0 %} <span class="badge bg-danger">{{ stats.unreadMessages }} nouveau(x)</span>{% endif %}</p>
      <a href="{{ path('admin_message_index') }}" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="table-card text-center">
      <i class="fas fa-users fa-2x mb-3" style="color: #FFBC00;"></i>
      <h3>{{ stats.users }}</h3>
      <p class="text-muted mb-0">Utilisateurs</p>
      <a href="{{ path('admin_user_index') }}" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-3">
    <div class="table-card">
      <h5 class="mb-3">
        <i class="fas fa-clock me-2"></i>Horaire d'ouverture
      </h5>
      <p class="text-muted">{{ stats.hours }} jours configurés</p>
      <a href="{{ path('admin_hours_index') }}" class="btn btn-sm btn-outline-primary">Gérer les horaires</a>
    </div>
  </div>

  <div class="col-md-3">
    <div class="table-card">
      <h5 class="mb-3">
        <i class="fas fa-bullhorn me-2"></i>Bandeau défilant
      </h5>
      <p class="text-muted">Promos, annonces, messages...</p>
      <a href="{{ path('admin_marquee_index') }}" class="btn btn-sm btn-outline-primary">Gérer le bandeau</a>
    </div>
  </div>
  
  <div class="col-md-6">
    <div class="table-card">
      <h5 class="mb-3">
        <i class="fas fa-envelope-open-text me-2"></i>Derniers messages non lus
      </h5>
      {% if recentMessages|length > 0 %}
        <ul class="list-group list-group-flush">
          {% for message in recentMessages %}
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <div>
                <strong>{{ message.firstName }} {{ message.lastName }}</strong>
                <br>
                <small class="text-muted">{{ message.subject }}</small>
              </div>
              <a href="{{ path('admin_message_show', {id: message.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="text-muted">Aucun message non lu.</p>
      {% endif %}
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-12">
    <div class="table-card">
      <h5 class="mb-3">
        <i class="fas fa-link me-2"></i>Liens rapides
      </h5>
      <div class="d-flex gap-2 flex-wrap">
        <a href="{{ path('app_home') }}" class="btn btn-primary" target="_blank">
          <i class="fas fa-external-link-alt me-1"></i> Voir le site
        </a>
        <a href="{{ path('admin_category_new') }}" class="btn btn-outline-primary">
          <i class="fas fa-plus me-1"></i> Nouvelle catégorie
        </a>
        <a href="{{ path('admin_dish_new') }}" class="btn btn-outline-primary">
          <i class="fas fa-plus me-1"></i> Nouveau plat
        </a>
        <a href="{{ path('admin_photo_new') }}" class="btn btn-outline-primary">
          <i class="fas fa-plus me-1"></i> Nouvelle photo
        </a>
      </div>
    </div>
  </div>
</div>
{% endblock %}

