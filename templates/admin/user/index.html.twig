{% extends 'admin/base.html.twig' %}

{% block title %}Utilisateurs - The Klassiker Admin{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="table-card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Liste des utilisateurs</h5>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
  {% endfor %}

  {% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
  {% endfor %}

  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th>ID</th>
          <th>Prénom</th>
          <th>Email</th>
          <th>Rôles</th>
          <th>Créé le</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
          <tr>
            <td>{{ user.id }}</td>
            <td>{{ user.firstName }}</td>
            <td>{{ user.email }}</td>
            <td>
              {% for role in user.roles %}
                {% if role == 'ROLE_ADMIN' %}
                  <span class="badge bg-danger">Admin</span>
                {% elseif role == 'ROLE_USER' %}
                  <span class="badge bg-primary">User</span>
                {% else %}
                  <span class="badge bg-secondary">{{ role }}</span>
                {% endif %}
              {% endfor %}
            </td>
            <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
            <td>
              <div class="d-flex gap-2">
                {% if user.email != app.user.email %}
                  <a href="{{ path('admin_user_toggle_role', {id: user.id}) }}" 
                     class="btn btn-sm btn-outline-warning"
                     title="Ajouter/Retirer ADMIN">
                    <i class="fas fa-user-shield"></i>
                  </a>
                  <a href="{{ path('admin_user_delete', {id: user.id}) }}" 
                     class="btn btn-sm btn-outline-danger"
                     title="Supprimer"
                     onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?')">
                    <i class="fas fa-trash"></i>
                  </a>
                {% else %}
                  <span class="badge bg-info">Vous</span>
                {% endif %}
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center text-muted">Aucun utilisateur trouvé.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

