{% extends 'admin/base.html.twig' %}
{% block title %}Suppléments - Admin{% endblock %}
{% block page_title %}Suppléments{% endblock %}

{% block body %}
<div class="table-card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Liste des suppléments</h2>
    <a href="{{ path('admin_supplement_new') }}" class="btn btn-primary">
      <i class="fas fa-plus"></i> Ajouter un supplément
    </a>
  </div>
  <p class="text-muted">Ces suppléments s'affichent dans la popup produit (extra fromage, sauce piquante, etc.)</p>
  <table class="table">
    <thead>
      <tr><th>Ordre</th><th>Nom</th><th>Prix</th><th>Statut</th><th>Actions</th></tr>
    </thead>
    <tbody>
      {% for supplement in supplements %}
      <tr>
        <td>{{ supplement.displayOrder }}</td>
        <td><strong>{{ supplement.name }}</strong></td>
        <td>{{ supplement.price|number_format(2, ',', ' ') }} €</td>
        <td>
          {% if supplement.isActive %}
            <span class="badge-active">Actif</span>
          {% else %}
            <span class="badge-inactive">Inactif</span>
          {% endif %}
        </td>
        <td>
          <a href="{{ path('admin_supplement_edit', {id: supplement.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
          <form method="post" action="{{ path('admin_supplement_delete', {id: supplement.id}) }}" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplement.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="text-center">Aucun supplément. Ajoutez-en un !</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
