{% extends 'admin/base.html.twig' %}
{% block title %}Nouveau supplément - Admin{% endblock %}
{% block page_title %}Nouveau supplément{% endblock %}
{% block body %}
<div class="table-card">
  <h2>Ajouter un supplément</h2>
  {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn btn-primary mt-3">Ajouter</button>
  {{ form_end(form) }}
  <div class="mt-3"><a href="{{ path('admin_supplement_index') }}" class="btn btn-outline-secondary">Retour</a></div>
</div>
{% endblock %}
