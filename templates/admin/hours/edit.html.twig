{% extends 'admin/base.html.twig' %}

{% block title %}Modifier l'horaire - The Klassiker Admin{% endblock %}
{% block page_title %}Modifier l'horaire{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Modifier l'horaire</h2>
  <p class="text-muted">Jour : <strong>{{ hours.dayName }}</strong></p>
  
  {{ form_start(form) }}
    {{ form_widget(form) }}
  {{ form_end(form) }}
  
  <div class="mt-3">
    <a href="{{ path('admin_hours_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
  </div>
</div>
{% endblock %}

