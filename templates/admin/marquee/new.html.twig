{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau message - Admin{% endblock %}
{% block page_title %}Nouveau message du bandeau{% endblock %}

{% block body %}
<div class="table-card">
  <h2>Ajouter un message</h2>
  {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit" class="btn btn-primary mt-3">Ajouter</button>
  {{ form_end(form) }}
  <div class="mt-3">
    <a href="{{ path('admin_marquee_index') }}" class="btn btn-outline-secondary">Retour</a>
  </div>
</div>
{% endblock %}
