{% extends 'base.html.twig' %}

{% block title %}Mon panier - The Klassiker{% endblock %}

{% block body %}
  <!-- ================= PAGE HERO ================= -->
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="hero-badge">Commande</p>
      <h1>Mon<span>panier</span></h1>
    </div>
  </section>

  <!-- ================= PANIER ================= -->
  <section class="section section-beige">
    <div class="cart-container">
      {% if cart|length > 0 %}
        <div class="cart-items">
          <h2>Articles ({{ cart|length }})</h2>
          
          {% for item in cart %}
            <div class="cart-item">
              <div class="cart-item-info">
                <h3>{{ item.dish_name }}</h3>
                {% if item.special_instructions %}
                  <p class="cart-item-notes">{{ item.special_instructions }}</p>
                {% endif %}
                <span class="cart-item-price">{{ item.unit_price|number_format(2, ',', ' ') }} €</span>
              </div>
              
              <div class="cart-item-actions">
                <form action="{{ path('app_order_update') }}" method="POST" class="qty-form">
                  <input type="hidden" name="index" value="{{ loop.index0 }}">
                  <button type="submit" name="quantity" value="{{ item.quantity - 1 }}" class="qty-btn" {% if item.quantity <= 1 %}disabled{% endif %}>−</button>
                </form>
                
                <span class="qty-value">{{ item.quantity }}</span>
                
                <form action="{{ path('app_order_update') }}" method="POST" class="qty-form">
                  <input type="hidden" name="index" value="{{ loop.index0 }}">
                  <button type="submit" name="quantity" value="{{ item.quantity + 1 }}" class="qty-btn">+</button>
                </form>
              </div>
              
              <div class="cart-item-subtotal">
                {{ (item.quantity * item.unit_price)|number_format(2, ',', ' ') }} €
              </div>
              
              <a href="{{ path('app_order_remove', {index: loop.index0}) }}" class="cart-item-remove" title="Supprimer">
                <i class="fas fa-trash"></i>
              </a>
            </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <h3>Récapitulatif</h3>
          
          <div class="cart-total">
            <span>Total</span>
            <span class="cart-total-amount">{{ cartTotal|number_format(2, ',', ' ') }} €</span>
          </div>
          
          <a href="{{ path('app_order_checkout') }}" class="btn btn-primary btn-full">
            Passer la commande
          </a>
          
          <a href="{{ path('app_order') }}" class="btn-link">
            ← Retour au menu
          </a>
        </div>
      {% else %}
        <div class="cart-empty">
          <div class="cart-empty-icon">
            <i class="fas fa-shopping-basket"></i>
          </div>
          <h2>Votre panier est vide</h2>
          <p>Découvrez notre carte et composez votre commande !</p>
          <a href="{{ path('app_order') }}" class="btn btn-primary">
            Voir le menu
          </a>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- ================= OPTIONS COMMANDE ================= -->
  <section class="section section-dark">
    <div class="order-options">
      <div class="order-option">
        <i class="fas fa-shopping-bag"></i>
        <h3>Click & Collect</h3>
        <p>Commandez et venez récupérer votre commande au restaurant.</p>
      </div>
      <div class="order-option">
        <i class="fas fa-motorcycle"></i>
        <h3>Livraison</h3>
        <p>Nous livrons à proximité. Livraison offerte dès 25€ !</p>
      </div>
    </div>
  </section>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .cart-container {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      gap: 30px;
    }

    .cart-items {
      background: #fff;
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .cart-items h2 {
      font-size: 1.2rem;
      margin: 0 0 20px;
      color: #0b1b32;
    }

    .cart-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      flex-wrap: wrap;
    }

    .cart-item:last-child {
      border-bottom: none;
    }

    .cart-item-info {
      flex: 1;
      min-width: 200px;
    }

    .cart-item-info h3 {
      margin: 0 0 4px;
      font-size: 1rem;
      color: #0b1b32;
    }

    .cart-item-notes {
      margin: 0 0 4px;
      font-size: 0.8rem;
      color: #888;
      font-style: italic;
    }

    .cart-item-price {
      font-size: 0.9rem;
      color: #666;
    }

    .cart-item-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .qty-form {
      display: inline;
    }

    .qty-btn {
      width: 32px;
      height: 32px;
      border: 1px solid #ddd;
      background: #fff;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .qty-btn:hover:not(:disabled) {
      background: #0b1b32;
      color: #fff;
      border-color: #0b1b32;
    }

    .qty-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .qty-value {
      font-weight: 600;
      min-width: 32px;
      text-align: center;
    }

    .cart-item-subtotal {
      font-weight: 700;
      font-size: 1.1rem;
      color: #0b1b32;
      min-width: 80px;
      text-align: right;
    }

    .cart-item-remove {
      color: #999;
      font-size: 1rem;
      padding: 8px;
      transition: color 0.2s ease;
    }

    .cart-item-remove:hover {
      color: #c00;
    }

    .cart-summary {
      background: #fff;
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .cart-summary h3 {
      margin: 0 0 20px;
      font-size: 1.2rem;
      color: #0b1b32;
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
      border-top: 2px solid #0b1b32;
      margin-bottom: 20px;
    }

    .cart-total-amount {
      font-size: 1.5rem;
      font-weight: 800;
      color: #9a1515;
    }

    .btn-full {
      width: 100%;
      justify-content: center;
      margin-bottom: 12px;
    }

    .cart-empty {
      text-align: center;
      padding: 60px 20px;
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .cart-empty-icon {
      font-size: 4rem;
      color: #ddd;
      margin-bottom: 20px;
    }

    .cart-empty h2 {
      margin: 0 0 10px;
      color: #0b1b32;
    }

    .cart-empty p {
      color: #666;
      margin-bottom: 24px;
    }

    .order-options {
      max-width: 900px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .order-option {
      text-align: center;
      padding: 24px;
      background: rgba(255,255,255,0.03);
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .order-option i {
      font-size: 2.5rem;
      color: #ffbc00;
      margin-bottom: 16px;
    }

    .order-option h3 {
      margin: 0 0 8px;
      font-size: 1.1rem;
    }

    .order-option p {
      margin: 0;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    @media (max-width: 768px) {
      .cart-item {
        flex-direction: column;
        align-items: flex-start;
      }
      
      .cart-item-actions,
      .cart-item-subtotal {
        width: 100%;
        justify-content: flex-start;
      }
      
      .cart-item-subtotal {
        margin-top: 8px;
      }
      
      .order-options {
        grid-template-columns: 1fr;
      }
    }
  </style>
{% endblock %}

